# ============================================================
# A.S.K - .gitignore
# קבצים ותיקיות שאינם חלק מקוד המקור ולא נכללים בהגשה/בריפו
# ============================================================

# --- Node / Frontend (תוצרי build והתקנה - לא להגיש!) ---
node_modules/
dist/
build/
.vite/
*.local

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# --- סודות ומשתני סביבה ---
.env
.env.*
!.env.example

# --- קבצים שהועלו על ידי משתמשים בזמן ריצה ---
# (תוכן משתמשים - לא חלק מקוד המקור, ומטעמי פרטיות אסור שייכלל בהגשה)
uploads/

# --- קבצי IDE ומערכת הפעלה ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- לוגים ---
*.log
npm-debug.log*
