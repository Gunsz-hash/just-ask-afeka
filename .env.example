# ============================================================
# A.S.K - קובץ דוגמה למשתני סביבה
# ============================================================
# העתיקו קובץ זה לקובץ בשם .env (באותה תיקייה של main.py)
# ומלאו ערכים אמיתיים. קובץ ה-.env עצמו לא נכלל בגרסת הקוד
# (מוחרג ב-.gitignore) כדי שסודות לא ייחשפו.
#
# הערה: הפרויקט ירוץ גם ללא קובץ .env (עם ערכי ברירת מחדל
# לפיתוח), אך בכל סביבה אמיתית חובה להגדיר ערכים חזקים.
# ============================================================

# מפתח חתימת ה-JWT - החליפו למחרוזת אקראית ארוכה (32+ תווים)
SECRET_KEY=change_me_to_a_long_random_string

# טוקן פנימי משותף בין n8n ל-FastAPI (עדכון תגיות אוטומטי)
# חייב להיות זהה לערך שנשלח מה-workflow של n8n ב-Header בשם x-n8n-token
N8N_SECRET_TOKEN=change_me_to_another_long_random_string

# מפתח ה-API של Google Gemini (נדרש עבור ה-workflows ב-n8n)
GOOGLE_API_KEY=your_google_gemini_api_key

# כתובות ה-webhooks של n8n - יש לעדכן רק אם n8n רץ בכתובת/פורט אחרים
N8N_AUTOTAG_URL=http://localhost:5678/webhook/auto-tag
N8N_CHAT_URL=http://localhost:5678/webhook/bc272bb0-115f-4a1d-aa20-477a833cdb9c/chat
N8N_UPLOAD_URL=http://localhost:5678/webhook/upload_file
